# openapi-typescript@7 declares a peer dependency on typescript ^5.x, but this
# workspace uses typescript ~6.0.2. The generator only needs typescript for
# type-level emit and works under 6.x. npm can only relax peer resolution for
# the whole ui workspace; remove this setting once the generator admits TS 6
# (or the workspace returns to a supported TS 5 release).
legacy-peer-deps=true
